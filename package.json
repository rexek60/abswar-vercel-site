{
  "name": "centradar-tactical-gridwar",
  "version": "10.0.0",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "node scripts/verify.mjs",
    "test": "npm run check",
    "contract:compile": "hardhat clean && hardhat compile --network abstractTestnet",
    "contract:deploy:testnet": "hardhat deploy-zksync --script deploy.ts --network abstractTestnet",
    "contract:deploy:mainnet": "hardhat deploy-zksync --script deploy.ts --network abstractMainnet",
    "rank-nft:deploy:testnet": "hardhat deploy-zksync --script deployRankNFT.ts --network abstractTestnet",
    "rank-nft:deploy:mainnet": "hardhat deploy-zksync --script deployRankNFT.ts --network abstractMainnet"
  },
  "dependencies": {
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@matterlabs/hardhat-zksync": "^1.6.2",
    "@types/node": "^22.19.19",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zksync-ethers": "^6.21.2"
  }
}
